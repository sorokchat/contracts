{
  "name": "@sorokchat/contracts",
  "version": "3.4.8",
  "description": "Контракти для сервісу sorokchat",
  "keywords": [
    "Контракти",
    "sorokchat"
  ],
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "author": "sorokovsky",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sorokchat/contracts.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "js-yaml": "^5.2.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "import": {
        "node": {
          "types": "./dist/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "browser": {
          "types": "./dist/index.d.ts",
          "default": "./dist/browser/index.js"
        }
      },
      "require": {
        "node": {
          "types": "./dist/index.d.cts",
          "default": "./dist/node/index.cjs"
        },
        "browser": {
          "types": "./dist/index.d.cts",
          "default": "./dist/browser/index.cjs"
        }
      }
    }
  }
}
